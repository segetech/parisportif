# Configuration du serveur et de l'application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
PING_MESSAGE="ping pong"

# Configuration Supabase Publique (accessible par le client Vite dans le navigateur)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Configuration Supabase Privilégiée (SERVEUR BACKEND UNIQUEMENT - NE JAMAIS EXPOSER AU CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Configuration Base de Données PostgreSQL / Prisma (Supabase)
# DATABASE_URL utilise le Connection Pooler (port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL utilise la connexion directe PostgreSQL (port 5432, requis pour Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Configuration SMTP pour l'envoi d'emails (Optionnel)
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=pari@example.com
EMAIL_PASSWORD=your-secure-email-password-here

# Configuration OpenAI / ChatGPT (SERVEUR BACKEND UNIQUEMENT - NE JAMAIS EXPOSER AU CLIENT)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
