model venue_games {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id   String    @db.Uuid
  game_name  String    @db.VarChar(255)
  active     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  venue      Venue     @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venue_id], map: "idx_venue_games_venue_id")
  @@index([game_name], map: "idx_venue_games_game_name")
}

model reference_aliases {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category       String    @db.VarChar(50)
  alias          String    @unique @db.VarChar(255)
  canonical_name String    @db.VarChar(255)
  is_confirmed   Boolean?  @default(false)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category, alias], map: "idx_reference_aliases_cat_alias")
}

model import_batches {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_name      String    @db.VarChar(255)
  sheet_name     String    @db.VarChar(100)
  entity_type    String    @db.VarChar(50)
  total_rows     Int       @default(0)
  imported_rows  Int       @default(0)
  rejected_rows  Int       @default(0)
  ignored_rows   Int       @default(0)
  status         String    @default("termine") @db.VarChar(50)
  anomalies      Json?     @default("[]")
  imported_by    String?   @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_import_batches_created_at")
  @@index([entity_type], map: "idx_import_batches_entity")
}
